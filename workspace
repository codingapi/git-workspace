#!/usr/bin/env python3
"""Workspace Projection Engine
==============================

在 Git 与构建系统之间的一层:声明式 workspace.yaml → 装配好的真实工程树。

核心模型——仓库分两种角色,引擎区别对待:

  1. 开发型仓库(工程的组成部分):真实 git worktree 直接装配在工程的逻辑
     位置上(如 flow-engine/、flow-engine/web/),IDE 打开工程根目录即可
     开发、构建、调试——真实目录,工作区内没有任何 symlink。
  2. 消费型依赖(只读输入):同样是真实 worktree,但配 sparse + readonly,
     文件系统级锁定,唯一写入者是本工具。

Git 过滤全自动:引擎按 yaml 声明的装配路径,在外层仓库与父级 worktree 的
exclude 中写入"托管块"(managed block),每次 sync 重写、自我修复。不属于
任何源装配路径的目录即本地代码,自动被外层 git 跟踪——无需任何手工
gitignore 配置。

布局:
    .workspace/git-cache/   bare/mirror 对象缓存(多 worktree 共享 objects)
    <各 source.path>        真实 Git worktree(装配位置,可嵌套)
    workspace.lock.yaml     解析后的 commit SHA 锁定快照

命令:
    workspace sync           拉取/更新全部源,物化 worktree,刷新 git 过滤,写 lock
    workspace sync --locked  严格模式:与 lock 不一致即失败(CI/团队复现)
    workspace status         查看各源状态
    workspace outdated       检查 lock 漂移与上游新版本
    workspace guard          提交防护:拒绝外层仓库暂存装配目录(git hook 调用)
    workspace clean          拆除 worktree(--all 连同 git 缓存)
"""

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent
CONFIG_PATH = ROOT / "workspace.yaml"
LOCK_PATH = ROOT / "workspace.lock.yaml"
DOT = ROOT / ".workspace"
CACHE = DOT / "git-cache"
STATE_PATH = DOT / "state.json"

BLOCK_BEGIN = "# workspace-engine managed (begin)"
BLOCK_END = "# workspace-engine managed (end)"
RESERVED_TOPS = {".git", ".workspace"}
RESERVED_FILES = {
    "workspace", "workspace.yaml", "workspace.lock.yaml",
    "Makefile", "README.md", ".gitignore", ".githooks",
}
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


class WorkspaceError(Exception):
    pass


# ---------------------------------------------------------------- helpers

def step(msg: str):
    print(f"==> {msg}")


def info(msg: str):
    print(f"    {msg}")


def die(msg: str):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def git(args, cwd=None):
    """运行 git,返回 stdout。失败抛出 WorkspaceError(携带 stderr)。"""
    proc = subprocess.run(
        ["git", *args],
        cwd=str(cwd) if cwd else None,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        raise WorkspaceError(f"git {' '.join(args)}\n  cwd={cwd}\n  {detail}")
    return proc.stdout.strip()


def load_state() -> dict:
    if STATE_PATH.exists():
        try:
            return json.loads(STATE_PATH.read_text())
        except json.JSONDecodeError:
            return {}
    return {}


def save_state(state: dict):
    DOT.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n")


class _Quoted(str):
    """YAML 序列化时强制加引号——sha 可能全为数字,裸标量会被读成整数。"""


yaml.add_representer(
    _Quoted,
    lambda d, data: d.represent_scalar("tag:yaml.org,2002:str", data, style='"'),
    Dumper=yaml.SafeDumper,  # safe_dump 用的是 SafeDumper,必须注册到它上面
)


def load_lock() -> dict:
    if not LOCK_PATH.exists():
        return {}
    try:
        data = yaml.safe_load(LOCK_PATH.read_text()) or {}
    except yaml.YAMLError:
        return {}
    out = {}
    for n, v in (data.get("sources") or {}).items():
        sha = str(v.get("sha", ""))
        if len(sha) != 40:  # 防御:全数字 sha 曾被 YAML 当整数解析而丢失前导零
            sha = ""
        out[n] = {**v, "sha": sha}
    return out


def source_path(src: dict, name: str) -> str:
    return src.get("path") or name


def cache_key(src: dict) -> str:
    """镜像缓存键:默认按 URL(同一仓库的多条配置自动共享一个对象库),
    可用 cache: 属性显式覆盖(如 URL 经常切换时固定缓存名)。"""
    if src.get("cache"):
        return src["cache"]
    return re.sub(r"[^A-Za-z0-9._-]+", "-", src["url"]).strip("-")


def all_source_paths(cfg) -> list:
    return sorted(
        Path(source_path(s, n)) for n, s in cfg["sources"].items()
    )


def minimal_cover(paths: list) -> list:
    """剔除被其他路径祖先覆盖的路径——祖先的忽略规则已涵盖后代。"""
    return [
        p for p in paths
        if not any(o != p and o in p.parents for o in paths)
    ]


def write_managed_block(path: Path, lines: list):
    """在文件中维护一个带标记的托管块:每次整体重写,自我修复、不残留。"""
    existing = path.read_text().splitlines() if path.exists() else []
    kept, in_block = [], False
    for ln in existing:
        if ln.strip() == BLOCK_BEGIN:
            in_block = True
            continue
        if ln.strip() == BLOCK_END:
            in_block = False
            continue
        if not in_block:
            kept.append(ln)
    while kept and not kept[-1].strip():
        kept.pop()
    if lines:
        kept += ["", BLOCK_BEGIN, *lines, BLOCK_END]
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(("\n".join(kept) + "\n") if kept else "")


# ---------------------------------------------------------------- config

def load_config() -> dict:
    if not CONFIG_PATH.exists():
        die(f"missing {CONFIG_PATH.name}")
    cfg = yaml.safe_load(CONFIG_PATH.read_text()) or {}
    if cfg.get("version") != 1:
        die("workspace.yaml: unsupported version (expected: 1)")

    sources = cfg.get("sources") or {}
    if not sources:
        die("workspace.yaml: no sources defined")

    paths_seen = {}
    for name, src in sources.items():
        if not NAME_RE.match(name):
            die(f"source name invalid: {name!r}")
        if not src.get("url"):
            die(f"source {name}: missing url")
        if not src.get("revision"):
            die(f"source {name}: missing revision")
        if not isinstance(src.get("readonly", False), bool):
            die(f"source {name}: readonly must be boolean")
        if src.get("cache") and not NAME_RE.match(src["cache"]):
            die(f"source {name}: invalid cache key {src['cache']!r}")
        for p in src.get("sparse") or []:
            if ".." in Path(p).parts:
                die(f"source {name}: sparse path escapes: {p}")
        # 装配位置校验
        path = source_path(src, name)
        parts = Path(path).parts
        if not parts or ".." in parts or "." in parts:
            die(f"source {name}: invalid path {path!r}")
        if parts[0] in RESERVED_TOPS:
            die(f"source {name}: path inside reserved dir {parts[0]!r}")
        if len(parts) == 1 and parts[0] in RESERVED_FILES:
            die(f"source {name}: path collides with workspace file {parts[0]!r}")
        if path in paths_seen:
            die(f"source {name}: duplicate path {path!r} (与 {paths_seen[path]} 冲突)")
        target = ROOT / path
        if target.exists() and not target.is_dir():
            die(f"source {name}: path {path!r} 被既有文件占用")
        paths_seen[path] = name

    # 嵌套规则:只读源内部不允许再装配其他源
    for name, src in sources.items():
        if not src.get("readonly"):
            continue
        p = Path(source_path(src, name))
        for other, src2 in sources.items():
            p2 = Path(source_path(src2, other))
            if other != name and p in p2.parents:
                die(f"source {other}: 不允许嵌套装配进只读源 {name} ({p})")

    cfg["sources"] = sources
    return cfg


# ---------------------------------------------------------------- git plumbing

def ensure_cache(src: dict, fetched: set):
    """clone --mirror 或增量更新对象缓存;同一缓存键一次 sync 内只 fetch 一次。"""
    key = cache_key(src)
    cache = CACHE / f"{key}.git"
    if key in fetched:
        return cache
    if cache.exists():
        git(["fetch", "--prune", "--quiet", "origin"], cwd=cache)
        info(f"mirror updated ({key})")
    else:
        CACHE.mkdir(parents=True, exist_ok=True)
        info(f"mirror cloning ... ({key})")
        git(["clone", "--mirror", "--quiet", src["url"], str(cache)])
    fetched.add(key)
    return cache


def resolve_sha(cache: Path, revision: str) -> str:
    out = git(["rev-parse", "--verify", "--quiet", f"{revision}^{{commit}}"], cwd=cache)
    if not out:
        raise WorkspaceError(f"cannot resolve revision {revision!r} in {cache.name}")
    return out


def worktree_head(wt: Path):
    try:
        return git(["rev-parse", "HEAD"], cwd=wt)
    except WorkspaceError:
        return None


# ---------------------------------------------------------------- read-only lock

def is_locked(wt: Path) -> bool:
    return not os.access(str(wt), os.W_OK)


def _chmod_no_follow(p: Path, mode: int):
    try:
        os.chmod(p, mode, follow_symlinks=False)
    except (NotImplementedError, OSError):
        if not p.is_symlink():
            os.chmod(p, mode)


def set_locked(wt: Path, on: bool):
    """文件系统级只读锁:锁定后任何编辑/新建/删除都失败,只有本工具解锁后可写。"""
    if on:
        for dirpath, _, filenames in os.walk(wt):
            for f in filenames:
                p = Path(dirpath) / f
                if not p.is_symlink():
                    _chmod_no_follow(p, p.stat().st_mode & ~0o222)
        for dirpath, _, _ in os.walk(wt, topdown=False):  # 目录自底向上,最后封门
            p = Path(dirpath)
            if not p.is_symlink():
                _chmod_no_follow(p, p.stat().st_mode & ~0o222)
    else:
        for dirpath, _, _ in os.walk(wt):                # 目录自顶向下,先开门
            p = Path(dirpath)
            if not p.is_symlink():
                _chmod_no_follow(p, p.stat().st_mode | 0o200)
        for dirpath, _, filenames in os.walk(wt):
            for f in filenames:
                p = Path(dirpath) / f
                if not p.is_symlink():
                    _chmod_no_follow(p, p.stat().st_mode | 0o200)


# ---------------------------------------------------------------- worktrees

def materialize_source(name, sha, sparse, readonly, path, cache, state):
    """在工程装配位置创建/更新真实 worktree;按需 sparse;readonly 源同步后上锁。"""
    wt = ROOT / path
    prev = state.get("sources", {}).get(name, {})
    label = f"sparse: {', '.join(sparse)}" if sparse else "full"
    if readonly:
        label += ", read-only"

    if (wt / ".git").exists():
        head = worktree_head(wt)
        sparse_changed = sorted(prev.get("sparse", [])) != sorted(sparse)
        empty = not any(e.name != ".git" for e in wt.iterdir())

        # 安全闸:基准是"上次同步点"而非目标 SHA——在 tag/分支间切换时,
        # HEAD 天然含有目标没有的上游提交,那不算本地工作
        if head != sha:
            if git(["status", "--porcelain"], cwd=wt):
                raise WorkspaceError(
                    f"{name}: 工作树有未提交改动。请先在 {path} 内 "
                    f"git commit/stash,再执行 sync"
                )
            prev_sha = prev.get("sha")
            if prev_sha and prev_sha != head:
                ahead = git(["rev-list", "--count", f"{prev_sha}..HEAD"], cwd=wt)
                if ahead not in ("0", ""):
                    raise WorkspaceError(
                        f"{name}: 相对上次同步点 {prev_sha[:12]} 存在 {ahead} 个本地提交,"
                        f"sync 拒绝覆盖。请先在 {path} 内推送/处理,再执行 sync"
                    )

        changed = sparse_changed or (head != sha) or empty
        if is_locked(wt):
            set_locked(wt, False)
        try:
            if sparse_changed:
                if sparse:
                    git(["sparse-checkout", "set", *sparse], cwd=wt)
                else:
                    git(["sparse-checkout", "disable"], cwd=wt)
            if head != sha:
                git(["checkout", "--quiet", "--detach", sha], cwd=wt)
            if empty:  # 防御:no-checkout 后未物化的空 worktree
                git(["read-tree", "-mu", "HEAD"], cwd=wt)
        finally:
            if readonly:
                set_locked(wt, True)
        info(f"{path}/  {'updated' if changed else 'up to date'} @ {sha[:12]} ({label})")
        return

    (ROOT / path).parent.mkdir(parents=True, exist_ok=True)
    if sparse:
        git(["worktree", "add", "--detach", "--no-checkout", "--quiet", str(wt), sha], cwd=cache)
        git(["sparse-checkout", "set", *sparse], cwd=wt)
        # --no-checkout 的 index 为空,sparse-checkout set 无条目可应用,需物化一次
        git(["read-tree", "-mu", "HEAD"], cwd=wt)
    else:
        git(["worktree", "add", "--detach", "--quiet", str(wt), sha], cwd=cache)
    if readonly:
        set_locked(wt, True)
    info(f"{path}/  created @ {sha[:12]} ({label})")


# ---------------------------------------------------------------- git 过滤(全自动)

def ensure_git_filters(cfg):
    """按装配路径精确管理 git 忽略,全部写入托管块(每次 sync 整体重写):

    - 外层仓库:忽略每个不被其他源覆盖的装配路径(+ .workspace)
      → 任何不在源装配路径下的目录自动成为"本地代码",被外层 git 跟踪
    - 嵌套装配:子路径写入父 worktree 的 exclude(linked worktree 的
      info/exclude 位于 commondir,而非 per-worktree 目录)
    """
    paths = all_source_paths(cfg)

    # 外层仓库
    if (ROOT / ".git").exists():
        lines = ["/.workspace/"]
        lines += [f"/{p.as_posix()}/" for p in minimal_cover(paths)]
        write_managed_block(ROOT / ".git" / "info" / "exclude", lines)

    # 父级 worktree 忽略嵌套子仓库(按父分组)
    by_parent = {}
    for p in paths:
        for o in paths:
            if o != p and p in o.parents:
                by_parent.setdefault(p, []).append(o.relative_to(p).as_posix() + "/")
    for parent, rels in by_parent.items():
        wt = ROOT / parent
        if not (wt / ".git").exists():
            continue
        common = Path(git(["rev-parse", "--git-common-dir"], cwd=wt))
        if not common.is_absolute():
            common = wt / common
        write_managed_block(common / "info" / "exclude", sorted(rels))

    info("git 过滤已按配置刷新(外层 exclude + 父级 worktree exclude)")


def ensure_hooks():
    """外层 git 仓库自动启用 pre-commit 防护(拦截三方代码误提交)。"""
    if not (ROOT / ".git").exists():
        return
    try:
        cur = git(["config", "--get", "core.hooksPath"], cwd=ROOT)
    except WorkspaceError:
        cur = ""
    if cur != ".githooks":
        git(["config", "core.hooksPath", ".githooks"], cwd=ROOT)
        info("pre-commit 防护钩子已启用 (core.hooksPath=.githooks)")


def protected_paths(cfg) -> set:
    """受保护路径 = 全部源装配路径(精确)+ .workspace。"""
    return {".workspace"} | {p.as_posix() for p in all_source_paths(cfg)}


# ---------------------------------------------------------------- commands

def cmd_sync(args):
    cfg = load_config()
    state = load_state()
    resolved = {}

    # 阶段一:拉取 + 解析(同一 URL 的多条配置共享一个镜像缓存)
    caches, fetched = {}, set()
    for name, src in cfg["sources"].items():
        step(f"source: {name}  ({src['url']})")
        caches[name] = ensure_cache(src, fetched)
        sha = resolve_sha(caches[name], src["revision"])
        resolved[name] = sha
        info(f"{src['revision']}  ->  {sha}")

    # --locked:严格复现模式,解析结果必须与 lock 完全一致(CI/团队协作)
    if getattr(args, "locked", False):
        lock = load_lock()
        violations = [
            (n, lock[n]["sha"], resolved[n])
            for n in cfg["sources"]
            if n in lock and lock[n].get("sha") != resolved[n]
        ]
        unknown = [n for n in cfg["sources"] if n not in lock]
        if violations or unknown:
            lines = [f"  {n}: lock {ls[:12]} != 解析 {rs[:12]}" for n, ls, rs in violations]
            lines += [f"  {n}: lock 中不存在" for n in unknown]
            raise WorkspaceError(
                "--locked 模式拒绝执行,以下源与 lock 不一致:\n" + "\n".join(lines)
                + "\n如为有意升级:先执行 ./workspace sync(不带 --locked)更新 lock,验证后与 workspace.yaml 一并提交"
            )

    # 阶段二:物化 worktree(父目录先建 → 按装配路径深度排序)
    ordered = sorted(
        cfg["sources"].items(),
        key=lambda kv: len(Path(source_path(kv[1], kv[0])).parts),
    )
    for name, src in ordered:
        materialize_source(
            name, resolved[name], src.get("sparse") or [],
            bool(src.get("readonly", False)), source_path(src, name),
            caches[name], state,
        )

    ensure_git_filters(cfg)

    state["sources"] = {
        name: {
            "sha": resolved[name],
            "sparse": src.get("sparse") or [],
            "readonly": bool(src.get("readonly", False)),
            "path": source_path(src, name),
        }
        for name, src in cfg["sources"].items()
    }
    save_state(state)

    lock = {
        "version": 1,
        "sources": {
            name: {
                "url": src["url"],
                "revision": src["revision"],
                "sha": _Quoted(resolved[name]),
            }
            for name, src in cfg["sources"].items()
        },
    }
    LOCK_PATH.write_text(
        "# Generated by `workspace sync` — 锁定各源的 commit,可提交入库以保证团队复现\n"
        + yaml.safe_dump(lock, sort_keys=False, allow_unicode=True)
    )
    ensure_hooks()
    step(f"done. lock written: {LOCK_PATH.name}")


def cmd_status(_args):
    cfg = load_config()
    print("Sources:")
    for name, src in cfg["sources"].items():
        path = source_path(src, name)
        wt = ROOT / path
        if not (wt / ".git").exists():
            print(f"  {name:<14} {path}/  (not materialized — run `workspace sync`)")
            continue
        head = worktree_head(wt) or "?"
        dirty = git(["status", "--porcelain"], cwd=wt)
        sparse = src.get("sparse") or []
        ro_cfg = bool(src.get("readonly", False))
        ro_state = "read-only" if ro_cfg else "writable"
        if ro_cfg and not is_locked(wt):
            ro_state = "read-only (未锁定!)"
        dirty_state = "DIRTY" if dirty else "clean"
        if dirty and ro_cfg:
            dirty_state = "DIRTY(只读源出现改动?!)"
        print(
            f"  {name:<14} {path}/  {head[:12]}  rev={src['revision']}"
            f"  {dirty_state}  {ro_state}"
            f"  {'sparse: ' + ', '.join(sparse) if sparse else 'full'}"
        )
    print(f"Lock: {LOCK_PATH.name} {'present' if LOCK_PATH.exists() else 'absent'}")


def cmd_outdated(_args):
    """对照 lock 检查各源:revision 当前解析值是否漂移、上游有无更新的 tag。"""
    cfg = load_config()
    lock = load_lock()
    for name, src in cfg["sources"].items():
        cache = CACHE / f"{cache_key(src)}.git"
        if not cache.exists():
            print(f"{name:<14} 无缓存 — 先执行 ./workspace sync")
            continue
        git(["fetch", "--prune", "--quiet", "origin"], cwd=cache)
        remote = resolve_sha(cache, src["revision"])
        locked = lock.get(name, {}).get("sha", "")
        tags = git(["tag", "--sort=-creatordate"], cwd=cache).splitlines()
        latest_tag = tags[0] if tags else "-"
        try:
            latest_sha = resolve_sha(cache, latest_tag) if tags else ""
        except WorkspaceError:
            latest_sha = ""
        drift = "DRIFT" if (locked and locked != remote) else "locked" if locked else "unlocked"
        newer = ""
        if latest_sha and latest_sha != locked and latest_sha != remote:
            newer = f"  ← 上游有更新版本: {latest_tag}"
        print(
            f"{name:<14} rev={src['revision']:<10} lock={locked[:12] or '-':<12} "
            f"解析={remote[:12]}  最新tag={latest_tag:<10} [{drift}]{newer}"
        )


def cmd_guard(_args):
    """提交防护(git pre-commit 钩子调用):拒绝将装配目录提交进外层仓库。"""
    cfg = load_config()
    protected = protected_paths(cfg)
    staged = git(["diff", "--cached", "--name-only"], cwd=ROOT).splitlines()
    bad = sorted({
        f for f in staged
        if any(f == p or f.startswith(p + "/") for p in protected)
    })
    gitlinks = []
    for line in git(["diff", "--cached", "--raw"], cwd=ROOT).splitlines():
        parts = line.split()
        if len(parts) >= 5 and parts[1] == "160000":
            gitlinks.append(line.split("\t", 1)[-1])
    if bad or gitlinks:
        print("✋ workspace guard 拒绝提交:", file=sys.stderr)
        for f in sorted(set(bad) | set(gitlinks)):
            print(f"     {f}", file=sys.stderr)
        print(
            "\n   规则:\n"
            "   - 装配目录(各源 worktree)→ 用各自的 git 提交(上游走 PR)\n"
            "   - 外层仓库 → 只提交 workspace.yaml/lock、文档、工具与本地代码目录\n"
            "   - 误操作 → git reset 移出暂存区后重试",
            file=sys.stderr,
        )
        sys.exit(1)
    sys.exit(0)


def cmd_clean(args):
    cfg = load_config()

    for name, src in cfg["sources"].items():
        path = source_path(src, name)
        wt = ROOT / path
        cache = CACHE / f"{cache_key(src)}.git"
        if (wt / ".git").exists() and cache.exists():
            if is_locked(wt):
                set_locked(wt, False)
            try:
                git(["worktree", "remove", "--force", str(wt)], cwd=cache)
            except WorkspaceError:
                import shutil
                shutil.rmtree(wt, ignore_errors=True)
                git(["worktree", "prune"], cwd=cache)
            info(f"removed worktree {path}/")

    # 回收空目录(自底向上)
    for d in sorted(all_source_paths(cfg), key=lambda p: -len(p.parts)):
        d = ROOT / d
        while d != ROOT and d.is_dir() and not any(d.iterdir()):
            d.rmdir()
            d = d.parent

    if args.all and CACHE.exists():
        import shutil
        shutil.rmtree(CACHE)
        info("removed git cache")

    if STATE_PATH.exists():
        STATE_PATH.unlink()
    step("clean done" + (" (including git cache)" if args.all else ""))


# ---------------------------------------------------------------- main

def main():
    parser = argparse.ArgumentParser(prog="workspace", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    p_sync = sub.add_parser("sync", help="拉取/更新源,物化 worktree,刷新 git 过滤")
    p_sync.add_argument(
        "--locked",
        action="store_true",
        help="严格模式:解析结果必须与 workspace.lock.yaml 一致,否则失败(CI/复现用)",
    )
    sub.add_parser("status", help="查看各源状态")
    sub.add_parser("outdated", help="检查各源相对 lock 的漂移与上游新版本")
    sub.add_parser("guard", help="提交防护检查(由 git pre-commit 钩子调用)")
    p_clean = sub.add_parser("clean", help="删除 worktree")
    p_clean.add_argument("--all", action="store_true", help="连同 .workspace/git-cache 一起删除")

    args = parser.parse_args()
    try:
        {
            "sync": cmd_sync,
            "status": cmd_status,
            "outdated": cmd_outdated,
            "guard": cmd_guard,
            "clean": cmd_clean,
        }[args.cmd](args)
    except WorkspaceError as e:
        die(str(e))
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
