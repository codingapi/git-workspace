#!/usr/bin/env python3
"""git-workspace — Workspace Projection Engine
==============================================

A layer between Git and your build system: a declarative git-workspace.yaml is
assembled into a real, ready-to-build project tree.

Core model — repositories come in two roles, handled differently:

  1. Development repos (parts of your product): real git worktrees assembled
     directly at their logical project locations (e.g. flow-engine/,
     flow-engine/web/). Open the project root in your IDE and develop, build
     and debug in real directories — there are no symlinks in the workspace.
  2. Consumed dependencies (read-only inputs): also real worktrees, but with
     checkout filters (include/exclude) plus a filesystem-level read-only
     lock; this tool is their only writer.

Git filtering is fully automatic: from the assembly paths declared in the
yaml, the engine writes "managed blocks" into the outer repo's and parent
worktrees' exclude files — rewritten on every sync, self-healing. Any
directory that is not an assembly path is local code, tracked by the outer
git repo automatically — no manual gitignore configuration needed.

Layout:
    .workspace/git-cache/        bare/mirror object caches (worktrees share objects)
    <each source.path>           real git worktree (assembly location, may nest)
    git-workspace.lock.yaml      resolved commit SHA lock snapshot

Commands:
    git-workspace init            create a starter git-workspace.yaml and commit-protection hooks
    git-workspace sync            fetch/update all sources, materialize worktrees, refresh git filters, write the lock
    git-workspace sync --locked   strict mode: fail on any mismatch with the lock (CI / team reproduction)
    git-workspace status          show per-source status
    git-workspace outdated        check lock drift and newer upstream versions
    git-workspace guard           commit protection: refuse staging assembly dirs in the outer repo (called by the git hook)
    git-workspace clean           remove worktrees (--all also removes the git cache)
    git-workspace version         print version and exit
"""

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

import yaml

__version__ = "0.1.0"

CONFIG_NAME = "git-workspace.yaml"
LOCK_NAME = "git-workspace.lock.yaml"

# Populated by init_paths() once the workspace root is resolved.
ROOT = None
CONFIG_PATH = None
LOCK_PATH = None
DOT = None
CACHE = None
STATE_PATH = None

BLOCK_BEGIN = "# git-workspace managed (begin)"
BLOCK_END = "# git-workspace managed (end)"
RESERVED_TOPS = {".git", ".workspace"}
RESERVED_FILES = {
    "git-workspace", "git-workspace.yaml", "git-workspace.lock.yaml",
    "Makefile", "README.md", ".gitignore", ".githooks",
}
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")

HOOK_SCRIPT = """#!/bin/sh
# Commit protection: policy is computed dynamically by the engine from
# git-workspace.yaml (protected paths = all assembly dirs + .workspace).
if command -v git-workspace >/dev/null 2>&1; then
    exec git-workspace guard
fi
exec ./git-workspace guard
"""

CONFIG_TEMPLATE = """\
# git-workspace declarative configuration
# Run `git-workspace sync` after editing to apply changes.
# Full syntax reference: README.md / example.yaml shipped with git-workspace.

version: 1

sources:
  # ── Development repo: full checkout assembled at a project location ────
  # my-backend:
  #   url: git@github.com:example/my-backend.git
  #   revision: main                    # branch | tag | SHA (resolved to a SHA in the lock)
  #   path: my-backend                  # assembly location; may nest (e.g. my-backend/web)

  # ── Third-party dependency: filtered checkout + filesystem read-only ───
  # my-lib:
  #   url: git@github.com:example/my-lib.git
  #   revision: v1.0.0                  # pin a tag for a stable snapshot
  #   path: libs/my-lib
  #   include: [core]                   # whitelist: only these dirs (git cone mode; top-level files always kept)
  #   # exclude: [docs]                 # blacklist alternative (mutually exclusive with include; supports nested paths)
  #   readonly: true                    # filesystem read-only; only `git-workspace sync` can write
"""


class WorkspaceError(Exception):
    pass


# ---------------------------------------------------------------- helpers

def step(msg: str):
    print(f"==> {msg}")


def info(msg: str):
    print(f"    {msg}")


def die(msg: str):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def git(args, cwd=None):
    """Run git and return stdout. Raises WorkspaceError (with stderr) on failure."""
    proc = subprocess.run(
        ["git", *args],
        cwd=str(cwd) if cwd else None,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        raise WorkspaceError(f"git {' '.join(args)}\n  cwd={cwd}\n  {detail}")
    return proc.stdout.strip()


def load_state() -> dict:
    if STATE_PATH.exists():
        try:
            return json.loads(STATE_PATH.read_text())
        except json.JSONDecodeError:
            return {}
    return {}


def save_state(state: dict):
    DOT.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n")


class _Quoted(str):
    """Force quotes on YAML serialization — an all-digit SHA would be read back as an integer."""


yaml.add_representer(
    _Quoted,
    lambda d, data: d.represent_scalar("tag:yaml.org,2002:str", data, style='"'),
    Dumper=yaml.SafeDumper,  # safe_dump uses SafeDumper, so register on it
)


def load_lock() -> dict:
    if not LOCK_PATH.exists():
        return {}
    try:
        data = yaml.safe_load(LOCK_PATH.read_text()) or {}
    except yaml.YAMLError:
        return {}
    out = {}
    for n, v in (data.get("sources") or {}).items():
        sha = str(v.get("sha", ""))
        if len(sha) != 40:  # defense: an all-digit SHA was once parsed as int by YAML, losing leading zeros
            sha = ""
        out[n] = {**v, "sha": sha}
    return out


def source_path(src: dict, name: str) -> str:
    return src.get("path") or name


def source_filter(src_or_state: dict) -> dict:
    """Checkout filter spec (mutually exclusive): {'include': [...]} / {'exclude': [...]} / {}.

    include → git cone mode (whitelist, git-recommended, fast);
    exclude → git non-cone mode (blacklist, gitignore-style negation, supports nested paths).
    """
    if src_or_state.get("include"):
        return {"include": sorted(src_or_state["include"])}
    if src_or_state.get("exclude"):
        return {"exclude": sorted(src_or_state["exclude"])}
    return {}


def apply_filter(wt: Path, filt: dict):
    if filt.get("include"):
        git(["sparse-checkout", "set", *filt["include"]], cwd=wt)   # cone
    elif filt.get("exclude"):
        # non-cone: include everything (/*), then prune via gitignore-style negation (! prefix)
        git(
            ["sparse-checkout", "set", "--no-cone", "/*",
             *[f"!/{p}" for p in filt["exclude"]]],
            cwd=wt,
        )
    else:
        git(["sparse-checkout", "disable"], cwd=wt)


def filter_label(filt: dict) -> str:
    if filt.get("include"):
        return "include: " + ", ".join(filt["include"])
    if filt.get("exclude"):
        return "exclude: " + ", ".join(filt["exclude"])
    return "full"


def cache_key(src: dict) -> str:
    """Mirror cache key: defaults to the URL (multiple sources from the same repo
    automatically share one object store); override with the cache: attribute
    (e.g. to pin the cache name when the URL changes often)."""
    if src.get("cache"):
        return src["cache"]
    return re.sub(r"[^A-Za-z0-9._-]+", "-", src["url"]).strip("-")


def all_source_paths(cfg) -> list:
    return sorted(
        Path(source_path(s, n)) for n, s in cfg["sources"].items()
    )


def minimal_cover(paths: list) -> list:
    """Drop paths covered by an ancestor — the ancestor's ignore rule already covers them."""
    return [
        p for p in paths
        if not any(o != p and o in p.parents for o in paths)
    ]


def write_managed_block(path: Path, lines: list):
    """Maintain a marked managed block in a file: rewritten wholesale each time, self-healing, no residue."""
    existing = path.read_text().splitlines() if path.exists() else []
    kept, in_block = [], False
    for ln in existing:
        if ln.strip() == BLOCK_BEGIN:
            in_block = True
            continue
        if ln.strip() == BLOCK_END:
            in_block = False
            continue
        if not in_block:
            kept.append(ln)
    while kept and not kept[-1].strip():
        kept.pop()
    if lines:
        kept += ["", BLOCK_BEGIN, *lines, BLOCK_END]
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(("\n".join(kept) + "\n") if kept else "")


# ---------------------------------------------------------------- workspace root

def find_root(required: bool = True):
    """Locate the workspace root: walk up from the CWD until git-workspace.yaml is found."""
    cur = Path.cwd()
    for d in [cur, *cur.parents]:
        if (d / CONFIG_NAME).exists():
            return d
    if required:
        die(
            f"{CONFIG_NAME} not found in {cur} or any parent directory"
            " — run `git-workspace init` to create one"
        )
    return None


def init_paths(root: Path):
    """Bind all derived paths to the resolved workspace root."""
    global ROOT, CONFIG_PATH, LOCK_PATH, DOT, CACHE, STATE_PATH
    ROOT = root
    CONFIG_PATH = root / CONFIG_NAME
    LOCK_PATH = root / LOCK_NAME
    DOT = root / ".workspace"
    CACHE = DOT / "git-cache"
    STATE_PATH = DOT / "state.json"


# ---------------------------------------------------------------- config

def load_config() -> dict:
    if not CONFIG_PATH.exists():
        die(f"missing {CONFIG_PATH.name}")
    cfg = yaml.safe_load(CONFIG_PATH.read_text()) or {}
    if cfg.get("version") != 1:
        die("git-workspace.yaml: unsupported version (expected: 1)")

    sources = cfg.get("sources") or {}
    if not sources:
        die("git-workspace.yaml: no sources defined")

    paths_seen = {}
    for name, src in sources.items():
        if not NAME_RE.match(name):
            die(f"source name invalid: {name!r}")
        if not src.get("url"):
            die(f"source {name}: missing url")
        if not src.get("revision"):
            die(f"source {name}: missing revision")
        if not isinstance(src.get("readonly", False), bool):
            die(f"source {name}: readonly must be boolean")
        if src.get("cache") and not NAME_RE.match(src["cache"]):
            die(f"source {name}: invalid cache key {src['cache']!r}")
        # checkout filters: include (whitelist) / exclude (blacklist), mutually exclusive
        if src.get("include") and src.get("exclude"):
            die(f"source {name}: include and exclude are mutually exclusive — pick one")
        for key in ("include", "exclude"):
            val = src.get(key) or []
            if not isinstance(val, list) or not all(isinstance(p, str) for p in val):
                die(f"source {name}: {key} must be a list of path strings")
            for p in val:
                if ".." in Path(p).parts:
                    die(f"source {name}: {key} path escapes: {p}")
        # assembly location validation
        path = source_path(src, name)
        parts = Path(path).parts
        if not parts or ".." in parts or "." in parts:
            die(f"source {name}: invalid path {path!r}")
        if parts[0] in RESERVED_TOPS:
            die(f"source {name}: path inside reserved dir {parts[0]!r}")
        if len(parts) == 1 and parts[0] in RESERVED_FILES:
            die(f"source {name}: path collides with workspace file {parts[0]!r}")
        if path in paths_seen:
            die(f"source {name}: duplicate path {path!r} (conflicts with {paths_seen[path]})")
        target = ROOT / path
        if target.exists() and not target.is_dir():
            die(f"source {name}: path {path!r} is occupied by an existing file")
        paths_seen[path] = name

    # nesting rule: no source may be assembled inside a read-only source
    for name, src in sources.items():
        if not src.get("readonly"):
            continue
        p = Path(source_path(src, name))
        for other, src2 in sources.items():
            p2 = Path(source_path(src2, other))
            if other != name and p in p2.parents:
                die(f"source {other}: cannot nest assembly inside read-only source {name} ({p})")

    cfg["sources"] = sources
    return cfg


# ---------------------------------------------------------------- git plumbing

def ensure_cache(src: dict, fetched: set):
    """clone --mirror or incrementally update the object cache; one fetch per cache key per sync."""
    key = cache_key(src)
    cache = CACHE / f"{key}.git"
    if key in fetched:
        return cache
    if cache.exists():
        git(["fetch", "--prune", "--quiet", "origin"], cwd=cache)
        info(f"mirror updated ({key})")
    else:
        CACHE.mkdir(parents=True, exist_ok=True)
        info(f"mirror cloning ... ({key})")
        git(["clone", "--mirror", "--quiet", src["url"], str(cache)])
    fetched.add(key)
    return cache


def resolve_sha(cache: Path, revision: str) -> str:
    out = git(["rev-parse", "--verify", "--quiet", f"{revision}^{{commit}}"], cwd=cache)
    if not out:
        raise WorkspaceError(f"cannot resolve revision {revision!r} in {cache.name}")
    return out


def worktree_head(wt: Path):
    try:
        return git(["rev-parse", "HEAD"], cwd=wt)
    except WorkspaceError:
        return None


# ---------------------------------------------------------------- read-only lock

def is_locked(wt: Path) -> bool:
    return not os.access(str(wt), os.W_OK)


def _chmod_no_follow(p: Path, mode: int):
    try:
        os.chmod(p, mode, follow_symlinks=False)
    except (NotImplementedError, OSError):
        if not p.is_symlink():
            os.chmod(p, mode)


def set_locked(wt: Path, on: bool):
    """Filesystem-level read-only lock: once locked, every edit/create/delete fails;
    only this tool can unlock and write. (On Windows this maps to the read-only
    file attribute, which os.access(W_OK) also honors.)"""
    if on:
        for dirpath, _, filenames in os.walk(wt):
            for f in filenames:
                p = Path(dirpath) / f
                if not p.is_symlink():
                    _chmod_no_follow(p, p.stat().st_mode & ~0o222)
        for dirpath, _, _ in os.walk(wt, topdown=False):  # dirs bottom-up, seal the door last
            p = Path(dirpath)
            if not p.is_symlink():
                _chmod_no_follow(p, p.stat().st_mode & ~0o222)
    else:
        for dirpath, _, _ in os.walk(wt):                # dirs top-down, open the door first
            p = Path(dirpath)
            if not p.is_symlink():
                _chmod_no_follow(p, p.stat().st_mode | 0o200)
        for dirpath, _, filenames in os.walk(wt):
            for f in filenames:
                p = Path(dirpath) / f
                if not p.is_symlink():
                    _chmod_no_follow(p, p.stat().st_mode | 0o200)


# ---------------------------------------------------------------- worktrees

def materialize_source(name, sha, filt, readonly, path, cache, state):
    """Create/update a real worktree at the assembly location; apply the checkout
    filter; lock read-only sources after syncing."""
    wt = ROOT / path
    prev = state.get("sources", {}).get(name, {})
    label = filter_label(filt)
    if readonly:
        label += ", read-only"

    if (wt / ".git").exists():
        head = worktree_head(wt)
        filter_changed = source_filter(prev) != filt
        empty = not any(e.name != ".git" for e in wt.iterdir())

        # Safety gate: the baseline is the *last sync point*, not the target SHA —
        # when switching between tags/branches, HEAD naturally contains upstream
        # commits the target lacks, and that is not local work.
        if head != sha:
            if git(["status", "--porcelain"], cwd=wt):
                raise WorkspaceError(
                    f"{name}: worktree has uncommitted changes — commit or stash"
                    f" them in {path}/ first, then re-run sync"
                )
            prev_sha = prev.get("sha")
            if prev_sha and prev_sha != head:
                ahead = git(["rev-list", "--count", f"{prev_sha}..HEAD"], cwd=wt)
                if ahead not in ("0", ""):
                    raise WorkspaceError(
                        f"{name}: {ahead} local commit(s) since last sync point"
                        f" {prev_sha[:12]} — sync refuses to overwrite; push or"
                        f" resolve them in {path}/ first, then re-run sync"
                    )

        changed = filter_changed or (head != sha) or empty
        if is_locked(wt):
            set_locked(wt, False)
        try:
            if filter_changed:
                apply_filter(wt, filt)
            if head != sha:
                git(["checkout", "--quiet", "--detach", sha], cwd=wt)
            if empty:  # defense: empty worktree never materialized after --no-checkout
                git(["read-tree", "-mu", "HEAD"], cwd=wt)
        finally:
            if readonly:
                set_locked(wt, True)
        info(f"{path}/  {'updated' if changed else 'up to date'} @ {sha[:12]} ({label})")
        return

    (ROOT / path).parent.mkdir(parents=True, exist_ok=True)
    if filt:
        git(["worktree", "add", "--detach", "--no-checkout", "--quiet", str(wt), sha], cwd=cache)
        apply_filter(wt, filt)
        # the --no-checkout index is empty, so the filter had no entries to apply — materialize once
        git(["read-tree", "-mu", "HEAD"], cwd=wt)
    else:
        git(["worktree", "add", "--detach", "--quiet", str(wt), sha], cwd=cache)
    if readonly:
        set_locked(wt, True)
    info(f"{path}/  created @ {sha[:12]} ({label})")


# ---------------------------------------------------------------- git filters (fully automatic)

def ensure_git_filters(cfg):
    """Manage git ignores precisely by assembly path, all written as managed
    blocks (rewritten wholesale on every sync):

    - outer repo: ignore each assembly path not covered by another source (+ .workspace)
      → any directory that is not a source assembly path automatically becomes
        "local code", tracked by the outer git repo
    - nested assembly: child paths are written into the parent worktree's exclude
      (a linked worktree's info/exclude lives in the commondir, not the
      per-worktree directory)
    """
    paths = all_source_paths(cfg)

    # outer repo
    if (ROOT / ".git").exists():
        lines = ["/.workspace/"]
        lines += [f"/{p.as_posix()}/" for p in minimal_cover(paths)]
        write_managed_block(ROOT / ".git" / "info" / "exclude", lines)

    # parent worktrees ignore nested child repos (grouped by parent)
    by_parent = {}
    for p in paths:
        for o in paths:
            if o != p and p in o.parents:
                by_parent.setdefault(p, []).append(o.relative_to(p).as_posix() + "/")
    for parent, rels in by_parent.items():
        wt = ROOT / parent
        if not (wt / ".git").exists():
            continue
        common = Path(git(["rev-parse", "--git-common-dir"], cwd=wt))
        if not common.is_absolute():
            common = wt / common
        write_managed_block(common / "info" / "exclude", sorted(rels))

    info("git filters refreshed from config (outer exclude + parent worktree excludes)")


def write_hook(path: Path):
    """Write the commit-protection hook (self-healing: rewritten on every sync).
    It prefers git-workspace from PATH and falls back to ./git-workspace."""
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(HOOK_SCRIPT)
    path.chmod(path.stat().st_mode | 0o111)


def ensure_hooks():
    """Auto-enable pre-commit protection in the outer git repo (blocks
    accidentally committing third-party code)."""
    if not (ROOT / ".git").exists():
        return
    write_hook(ROOT / ".githooks" / "pre-commit")
    try:
        cur = git(["config", "--get", "core.hooksPath"], cwd=ROOT)
    except WorkspaceError:
        cur = ""
    if cur != ".githooks":
        git(["config", "core.hooksPath", ".githooks"], cwd=ROOT)
        info("commit-protection hook enabled (core.hooksPath=.githooks)")


def protected_paths(cfg) -> set:
    """Protected paths = all source assembly paths (exact) + .workspace."""
    return {".workspace"} | {p.as_posix() for p in all_source_paths(cfg)}


# ---------------------------------------------------------------- commands

def cmd_init(_args):
    """Scaffold a new workspace: starter config + commit-protection hooks."""
    if CONFIG_PATH.exists():
        die(f"{CONFIG_NAME} already exists — nothing to do")
    CONFIG_PATH.write_text(CONFIG_TEMPLATE)
    info(f"created {CONFIG_NAME} (edit it to declare your sources)")

    write_hook(ROOT / ".githooks" / "pre-commit")
    info("created .githooks/pre-commit")
    if (ROOT / ".git").exists():
        git(["config", "core.hooksPath", ".githooks"], cwd=ROOT)
        info("enabled commit protection (core.hooksPath=.githooks)")
    else:
        info("note: not a git repository — run `git init` to enable commit protection")

    step(f"done. next: edit {CONFIG_NAME}, then run `git-workspace sync`")


def cmd_sync(args):
    cfg = load_config()
    state = load_state()
    resolved = {}

    # Phase 1: fetch + resolve (sources sharing a URL share one mirror cache)
    caches, fetched = {}, set()
    for name, src in cfg["sources"].items():
        step(f"source: {name}  ({src['url']})")
        caches[name] = ensure_cache(src, fetched)
        sha = resolve_sha(caches[name], src["revision"])
        resolved[name] = sha
        info(f"{src['revision']}  ->  {sha}")

    # --locked: strict reproduction mode — resolved SHAs must match the lock exactly (CI / team collaboration)
    if getattr(args, "locked", False):
        lock = load_lock()
        violations = [
            (n, lock[n]["sha"], resolved[n])
            for n in cfg["sources"]
            if n in lock and lock[n].get("sha") != resolved[n]
        ]
        unknown = [n for n in cfg["sources"] if n not in lock]
        if violations or unknown:
            lines = [f"  {n}: lock {ls[:12]} != resolved {rs[:12]}" for n, ls, rs in violations]
            lines += [f"  {n}: not present in lock" for n in unknown]
            raise WorkspaceError(
                "--locked mode refused to run: the following sources disagree with the lock:\n"
                + "\n".join(lines)
                + "\nIf this is an intentional upgrade: run `git-workspace sync` (without"
                " --locked) to update the lock, verify, then commit git-workspace.yaml and the lock together"
            )

    # Phase 2: materialize worktrees (parents first — ordered by assembly path depth)
    ordered = sorted(
        cfg["sources"].items(),
        key=lambda kv: len(Path(source_path(kv[1], kv[0])).parts),
    )
    for name, src in ordered:
        materialize_source(
            name, resolved[name], source_filter(src),
            bool(src.get("readonly", False)), source_path(src, name),
            caches[name], state,
        )

    ensure_git_filters(cfg)

    state["sources"] = {
        name: {
            "sha": resolved[name],
            "include": src.get("include") or [],
            "exclude": src.get("exclude") or [],
            "readonly": bool(src.get("readonly", False)),
            "path": source_path(src, name),
        }
        for name, src in cfg["sources"].items()
    }
    save_state(state)

    lock = {
        "version": 1,
        "sources": {
            name: {
                "url": src["url"],
                "revision": src["revision"],
                "sha": _Quoted(resolved[name]),
            }
            for name, src in cfg["sources"].items()
        },
    }
    LOCK_PATH.write_text(
        "# Generated by `git-workspace sync` — locks each source's commit; commit this file for team-wide reproduction\n"
        + yaml.safe_dump(lock, sort_keys=False, allow_unicode=True)
    )
    ensure_hooks()
    step(f"done. lock written: {LOCK_PATH.name}")


def cmd_status(_args):
    cfg = load_config()
    print("Sources:")
    for name, src in cfg["sources"].items():
        path = source_path(src, name)
        wt = ROOT / path
        if not (wt / ".git").exists():
            print(f"  {name:<14} {path}/  (not materialized — run `git-workspace sync`)")
            continue
        head = worktree_head(wt) or "?"
        dirty = git(["status", "--porcelain"], cwd=wt)
        ro_cfg = bool(src.get("readonly", False))
        ro_state = "read-only" if ro_cfg else "writable"
        if ro_cfg and not is_locked(wt):
            ro_state = "read-only (NOT LOCKED!)"
        dirty_state = "DIRTY" if dirty else "clean"
        if dirty and ro_cfg:
            dirty_state = "DIRTY (changes in a read-only source?!)"
        print(
            f"  {name:<14} {path}/  {head[:12]}  rev={src['revision']}"
            f"  {dirty_state}  {ro_state}  {filter_label(source_filter(src))}"
        )
    print(f"Lock: {LOCK_PATH.name} {'present' if LOCK_PATH.exists() else 'absent'}")


def cmd_outdated(_args):
    """Compare each source against the lock: has the revision drifted, and are there newer upstream tags?"""
    cfg = load_config()
    lock = load_lock()
    for name, src in cfg["sources"].items():
        cache = CACHE / f"{cache_key(src)}.git"
        if not cache.exists():
            print(f"{name:<14} no cache — run `git-workspace sync` first")
            continue
        git(["fetch", "--prune", "--quiet", "origin"], cwd=cache)
        remote = resolve_sha(cache, src["revision"])
        locked = lock.get(name, {}).get("sha", "")
        tags = git(["tag", "--sort=-creatordate"], cwd=cache).splitlines()
        latest_tag = tags[0] if tags else "-"
        try:
            latest_sha = resolve_sha(cache, latest_tag) if tags else ""
        except WorkspaceError:
            latest_sha = ""
        drift = "DRIFT" if (locked and locked != remote) else "locked" if locked else "unlocked"
        newer = ""
        if latest_sha and latest_sha != locked and latest_sha != remote:
            newer = f"  <- newer upstream version: {latest_tag}"
        print(
            f"{name:<14} rev={src['revision']:<10} lock={locked[:12] or '-':<12} "
            f"resolved={remote[:12]}  latest-tag={latest_tag:<10} [{drift}]{newer}"
        )


def cmd_guard(_args):
    """Commit protection (called by the git pre-commit hook): refuse committing
    assembly directories into the outer repo. Deliberately lenient: a missing,
    empty or unparseable config never blocks commits — `sync` reports those."""
    try:
        cfg = yaml.safe_load(CONFIG_PATH.read_text()) or {}
    except (yaml.YAMLError, OSError):
        sys.exit(0)
    sources = cfg.get("sources") or {}
    if not isinstance(sources, dict) or not sources:
        sys.exit(0)  # no sources → no assembly paths → nothing to protect
    protected = {".workspace"}
    for n, s in sources.items():
        p = (s.get("path") or n) if isinstance(s, dict) else n
        protected.add(Path(p).as_posix())
    staged = git(["diff", "--cached", "--name-only"], cwd=ROOT).splitlines()
    bad = sorted({
        f for f in staged
        if any(f == p or f.startswith(p + "/") for p in protected)
    })
    gitlinks = []
    for line in git(["diff", "--cached", "--raw"], cwd=ROOT).splitlines():
        parts = line.split()
        if len(parts) >= 5 and parts[1] == "160000":
            gitlinks.append(line.split("\t", 1)[-1])
    if bad or gitlinks:
        print("✋ git-workspace guard rejected this commit:", file=sys.stderr)
        for f in sorted(set(bad) | set(gitlinks)):
            print(f"     {f}", file=sys.stderr)
        print(
            "\n   Rules:\n"
            "   - Assembly dirs (source worktrees) → commit inside their own repo (upstream via PR)\n"
            "   - Outer repo → commit only git-workspace.yaml/lock, docs, tooling and local code dirs\n"
            "   - Mistake → unstage with `git reset` and retry",
            file=sys.stderr,
        )
        sys.exit(1)
    sys.exit(0)


def cmd_clean(args):
    cfg = load_config()

    for name, src in cfg["sources"].items():
        path = source_path(src, name)
        wt = ROOT / path
        cache = CACHE / f"{cache_key(src)}.git"
        if (wt / ".git").exists() and cache.exists():
            if is_locked(wt):
                set_locked(wt, False)
            try:
                git(["worktree", "remove", "--force", str(wt)], cwd=cache)
            except WorkspaceError:
                import shutil
                shutil.rmtree(wt, ignore_errors=True)
                git(["worktree", "prune"], cwd=cache)
            info(f"removed worktree {path}/")

    # reclaim empty directories (bottom-up)
    for d in sorted(all_source_paths(cfg), key=lambda p: -len(p.parts)):
        d = ROOT / d
        while d != ROOT and d.is_dir() and not any(d.iterdir()):
            d.rmdir()
            d = d.parent

    if args.all and CACHE.exists():
        import shutil
        shutil.rmtree(CACHE)
        info("removed git cache")

    if STATE_PATH.exists():
        STATE_PATH.unlink()
    step("clean done" + (" (including git cache)" if args.all else ""))


# ---------------------------------------------------------------- main

EPILOG = """examples:
  git-workspace init                create a starter git-workspace.yaml and commit-protection hooks
  git-workspace sync                fetch sources, materialize worktrees, refresh the lock
  git-workspace sync --locked       strict mode: fail on any mismatch with the lock (CI)
  git-workspace status              show per-source SHA, dirty, filter and read-only state
  git-workspace outdated            check lock drift and newer upstream tags
  git-workspace clean [--all]       remove worktrees (--all also removes the git cache)
"""


def main():
    parser = argparse.ArgumentParser(
        prog="git-workspace",
        description=__doc__.splitlines()[0],
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "-V", "--version", action="version", version=f"%(prog)s {__version__}",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("init", help="create a starter git-workspace.yaml and commit-protection hooks")
    p_sync = sub.add_parser("sync", help="fetch/update sources, materialize worktrees, refresh git filters")
    p_sync.add_argument(
        "--locked",
        action="store_true",
        help="strict mode: resolved SHAs must match git-workspace.lock.yaml or fail (CI / reproduction)",
    )
    sub.add_parser("status", help="show per-source status")
    sub.add_parser("outdated", help="check lock drift and newer upstream versions")
    sub.add_parser("guard", help="commit-protection check (called by the git pre-commit hook)")
    p_clean = sub.add_parser("clean", help="remove worktrees")
    p_clean.add_argument("--all", action="store_true", help="also remove .workspace/git-cache")
    sub.add_parser("version", help="print version and exit")

    args = parser.parse_args()

    try:
        # `version` needs no workspace; `init` creates one in the CWD.
        if args.cmd == "version":
            print(f"git-workspace {__version__}")
            return
        if args.cmd == "init":
            init_paths(Path.cwd())
            cmd_init(args)
            return
        # `guard` is lenient: no config → no assembly paths → nothing to protect.
        if args.cmd == "guard":
            root = find_root(required=False)
            if root is None:
                sys.exit(0)
            init_paths(root)
            cmd_guard(args)
            return
        init_paths(find_root())
        {
            "sync": cmd_sync,
            "status": cmd_status,
            "outdated": cmd_outdated,
            "clean": cmd_clean,
        }[args.cmd](args)
    except WorkspaceError as e:
        die(str(e))
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
