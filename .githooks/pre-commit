#!/bin/sh
# ============================================================
# 外层仓库提交防护
# 1. 拒绝提交受保护路径(.sources/ .workspace/ product/)下的任何内容
#    —— 即使通过 git add -f 强加也拦截
# 2. 拒绝嵌入式 git 仓库(gitlink, mode 160000)进入提交
# 三方代码请在 .sources/<name> 内各自的 git 仓库中提交(走上游 PR 流程);
# 外层仓库只收录本地配置、文档、工具与 lock 文件。
# ============================================================

staged=$(git diff --cached --name-only)

for p in .sources/ .workspace/ product/ node_modules/; do
    bad=$(printf '%s\n' "$staged" | grep "^$p" || true)
    if [ -n "$bad" ]; then
        echo "✋ pre-commit 拒绝:受保护路径下的内容不允许进入外层仓库:" >&2
        printf '%s\n' "$bad" | sed 's/^/     /' >&2
        cat >&2 <<'EOF'

   规则:
   - 三方/上游代码 → 在 .sources/<name> 内用该仓库自己的 git 提交并推上游
   - 外层仓库     → 只提交 workspace.yaml、lock、文档、工具等本地内容
   - 如属误操作   → git reset 将上述文件移出暂存区后重试
EOF
        exit 1
    fi
done

gitlinks=$(git diff --cached --raw | awk '$2 == "160000" {print $NF}')
if [ -n "$gitlinks" ]; then
    echo "✋ pre-commit 拒绝:检测到嵌入式 git 仓库(gitlink):" >&2
    printf '%s\n' "$gitlinks" | sed 's/^/     /' >&2
    echo "   不要把含有 .git 的目录加入外层仓库。" >&2
    exit 1
fi

exit 0
